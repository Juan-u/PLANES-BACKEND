DEPLOYMENT_PROFILE=railway-production
NODE_ENV=production
APP_HOST=::
PORT=3000
PRODUCTION_MYSQL_SERVICE_NAME=MySQL-EZwX
PRODUCTION_DB_HOST=${{MySQL-EZwX.RAILWAY_PRIVATE_DOMAIN}}
PRODUCTION_DB_NAME=REPLACE_WITH_THE_EXACT_DATABASE_NAME_FROM_RAILWAY
DB_HOST=${{MySQL-EZwX.RAILWAY_PRIVATE_DOMAIN}}
DB_PORT=3306
DB_NAME=REPLACE_WITH_THE_EXACT_DATABASE_NAME_FROM_RAILWAY
DB_USER=planes_backend
DB_PASSWORD=
JWT_SECRET=
ENABLE_ROLE_PERMISSION_ROUTES=false
ENABLE_ROLE_PERMISSION_ADMINISTRATION=false
ROLE_PERMISSION_PRODUCTION_CONFIRMATION=
ROLE_APPROVAL_WINDOW_MS=
EVIDENCE_STORAGE_DIR=/data/evidence
# RAILWAY_PROJECT_NAME and RAILWAY_ENVIRONMENT_NAME are supplied by Railway.
# RAILWAY_VOLUME_MOUNT_PATH is supplied only when the evidence volume is mounted.
