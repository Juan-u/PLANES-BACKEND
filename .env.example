# Plantilla sin secretos. Copiar a .env.local SOLO en una instalación nueva.
NODE_ENV=development
PORT=3000
APP_HOST=127.0.0.1
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=planes_accion_test
DB_USER=planes_test
DB_PASSWORD=
# Base64URL aleatorio de al menos 32 bytes; no reutilizar claves de otros entornos.
JWT_SECRET=
ENABLE_ROLE_PERMISSION_ROUTES=true
# Reutilizar la ventana aprobada para el entorno; no deducir una política nueva.
ROLE_APPROVAL_WINDOW_MS=
# Ruta privada absoluta fuera de las imágenes. Vacío: omitir esta variable.
# EVIDENCE_STORAGE_DIR=
